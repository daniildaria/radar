# https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=your_api_hash
# После первого запуска можно вставить сюда StringSession (см. README)
TG_SESSION=kupolrussia,lpr1_treugolnik
# Каналы-источники через запятую (username без @)
CHANNELS=channel_one,channel_two
# Токен бота (для проверки initData). REQUIRE_TG_AUTH=1 включает проверку
BOT_TOKEN=
REQUIRE_TG_AUTH=0
# Сколько минут событие остаётся на карте
EVENT_TTL_MIN=30
